rules_version = '2';
// users/{uid}/entries/{id}: date YYYY-MM-DD, title 1..80, body 1..10000,
// mood enum; createdAt immutable timestamp; updatedAt server timestamp.
// Ownership is encoded in the path, never supplied by a client field.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isValidEntry() {
      let d = request.resource.data;
      return d.keys().hasAll(['date','title','body','mood','createdAt','updatedAt'])
        && d.keys().hasOnly(['date','title','body','mood','createdAt','updatedAt'])
        && d.date is string && d.date.size() == 10
        && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.body is string && d.body.size() > 0 && d.body.size() <= 10000
        && d.mood is string && d.mood in ['happy','calm','tired','thoughtful']
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.updatedAt == request.time;
    }
    match /users/{uid}/entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidEntry()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isValidEntry()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
